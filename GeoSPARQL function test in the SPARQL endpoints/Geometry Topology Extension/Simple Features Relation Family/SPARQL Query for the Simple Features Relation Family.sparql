# The following functions, which are defined identically in both
# GeoSPARQL 1.0 and GeoSPARQL 1.1, were tested:
#
# 1. Simple Features Relation Family
#    - geof:sfEquals
#    - geof:sfDisjoint
#    - geof:sfIntersects
#    - geof:sfTouches
#    - geof:sfCrosses
#    - geof:sfWithin
#    - geof:sfContains
#    - geof:sfOverlaps

PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT ?relation ?result
WHERE {
  {
    BIND("sfEquals" AS ?relation)
    BIND(
      geof:sfEquals(
        "POINT(1 1)"^^geo:wktLiteral,
        "POINT(1 1)"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfDisjoint" AS ?relation)
    BIND(
      geof:sfDisjoint(
        "POINT(1 1)"^^geo:wktLiteral,
        "POINT(10 10)"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfIntersects" AS ?relation)
    BIND(
      geof:sfIntersects(
        "LINESTRING(0 0, 2 2)"^^geo:wktLiteral,
        "LINESTRING(0 2, 2 0)"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfTouches" AS ?relation)
    BIND(
      geof:sfTouches(
        "POLYGON((0 0, 0 2, 2 2, 2 0, 0 0))"^^geo:wktLiteral,
        "POLYGON((2 0, 2 2, 4 2, 4 0, 2 0))"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfCrosses" AS ?relation)
    BIND(
      geof:sfCrosses(
        "LINESTRING(0 0, 2 2)"^^geo:wktLiteral,
        "LINESTRING(0 2, 2 0)"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfWithin" AS ?relation)
    BIND(
      geof:sfWithin(
        "POINT(1 1)"^^geo:wktLiteral,
        "POLYGON((0 0, 0 2, 2 2, 2 0, 0 0))"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfContains" AS ?relation)
    BIND(
      geof:sfContains(
        "POLYGON((0 0, 0 2, 2 2, 2 0, 0 0))"^^geo:wktLiteral,
        "POINT(1 1)"^^geo:wktLiteral
      ) AS ?result
    )
  }
  UNION
  {
    BIND("sfOverlaps" AS ?relation)
    BIND(
      geof:sfOverlaps(
        "POLYGON((0 0, 0 3, 3 3, 3 0, 0 0))"^^geo:wktLiteral,
        "POLYGON((2 2, 2 4, 4 4, 4 2, 2 2))"^^geo:wktLiteral
      ) AS ?result
    )
  }
}
ORDER BY ?relation