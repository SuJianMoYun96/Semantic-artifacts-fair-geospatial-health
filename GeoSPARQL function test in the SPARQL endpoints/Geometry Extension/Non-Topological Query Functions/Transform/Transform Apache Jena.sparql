PREFIX geo:      <http://www.opengis.net/ont/geosparql#>
PREFIX spatialF: <http://jena.apache.org/function/spatial#>

SELECT ?source ?webMercator ?rdNew
WHERE {
    BIND(
        "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(4.8980 52.3728)"
        ^^geo:wktLiteral
        AS ?source
    )

    BIND(
        spatialF:transformSRS(
            ?source,
            <http://www.opengis.net/def/crs/EPSG/0/3857>
        )
        AS ?webMercator
    )

    BIND(
        spatialF:transformSRS(
            ?source,
            <http://www.opengis.net/def/crs/EPSG/0/28992>
        )
        AS ?rdNew
    )

    BIND(
        geof:transform(
            ?source,
            <http://www.opengis.net/def/crs/EPSG/0/28992>
        )
        AS ?transformed
    )
}

