#When the unit is set to `unity` or `grid-spacing`, `unity` is reported as unsupported.

PREFIX geo:      <http://www.opengis.net/ont/geosparql#>
PREFIX geof:     <http://www.opengis.net/def/function/geosparql/>
PREFIX uom:      <http://www.opengis.net/def/uom/OGC/1.0/>
PREFIX spatialF: <http://jena.apache.org/function/spatial#>

SELECT
  ?geofMetre
  ?spatialMetre

  ?geofKilometre
  ?spatialKilometre

  ?geofStatuteMile
  ?spatialStatuteMile

  ?geofFoot
  ?spatialFoot

  ?geofYard
  ?spatialYard

  ?geofRadian
  ?spatialRadian

  ?geofDegree
  ?spatialDegree

  ?geofUnity
  ?spatialUnity

  ?geofGridSpacing
  ?spatialGridSpacing

WHERE {

  BIND(
    "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(4.9003 52.3791)"
    ^^geo:wktLiteral
    AS ?p1
  )

  BIND(
    "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(4.9013 52.3791)"
    ^^geo:wktLiteral
    AS ?p2
  )

  # ---------------------------------------------------------
  # Metre (M)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:metre)
    AS ?geofMetre
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:metre)
    AS ?spatialMetre
  )


  # ---------------------------------------------------------
  # Kilometre (KM)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:kilometre)
    AS ?geofKilometre
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:kilometre)
    AS ?spatialKilometre
  )


  # ---------------------------------------------------------
  # Land / Statute Mile (MI)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:statuteMile)
    AS ?geofStatuteMile
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:statuteMile)
    AS ?spatialStatuteMile
  )


  # ---------------------------------------------------------
  # Foot (FT)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:foot)
    AS ?geofFoot
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:foot)
    AS ?spatialFoot
  )


  # ---------------------------------------------------------
  # Yard (YD)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:yard)
    AS ?geofYard
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:yard)
    AS ?spatialYard
  )


  # ---------------------------------------------------------
  # Radian (R)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:radian)
    AS ?geofRadian
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:radian)
    AS ?spatialRadian
  )


  # ---------------------------------------------------------
  # Degree (D)
  # ---------------------------------------------------------

  BIND(
    geof:distance(?p1, ?p2, uom:degree)
    AS ?geofDegree
  )

  BIND(
    spatialF:distance(?p1, ?p2, uom:degree)
    AS ?spatialDegree
  )



}