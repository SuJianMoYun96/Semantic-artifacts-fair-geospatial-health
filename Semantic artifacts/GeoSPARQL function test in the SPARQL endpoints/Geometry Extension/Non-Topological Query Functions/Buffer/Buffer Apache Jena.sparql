PREFIX geo:      <http://www.opengis.net/ont/geosparql#>
PREFIX geof:     <http://www.opengis.net/def/function/geosparql/>
PREFIX uom:      <http://www.opengis.net/def/uom/OGC/1.0/>
PREFIX spatialF: <http://jena.apache.org/function/spatial#>

SELECT
  ?geofMetre
  ?spatialMetre

  ?geofKilometre
  ?spatialKilometre

  ?geofStatuteMile
  ?spatialStatuteMile

  ?geofFoot
  ?spatialFoot

  ?geofYard
  ?spatialYard

  ?geofRadian
  ?spatialRadian

  ?geofDegree
  ?spatialDegree

  ?geofUnity
  ?spatialUnity

  ?geofGridSpacing
  ?spatialGridSpacing

WHERE {

  BIND(
    "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(4.9003 52.3791)"
    ^^geo:wktLiteral
    AS ?point
  )


  # ---------------------------------------------------------
  # Metre (M)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:metre)
    AS ?geofMetre
  )

  BIND(
    spatialF:buffer(?point, 1, uom:metre)
    AS ?spatialMetre
  )


  # ---------------------------------------------------------
  # Kilometre (KM)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:kilometre)
    AS ?geofKilometre
  )

  BIND(
    spatialF:buffer(?point, 1, uom:kilometre)
    AS ?spatialKilometre
  )


  # ---------------------------------------------------------
  # Land / Statute Mile (MI)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:statuteMile)
    AS ?geofStatuteMile
  )

  BIND(
    spatialF:buffer(?point, 1, uom:statuteMile)
    AS ?spatialStatuteMile
  )


  # ---------------------------------------------------------
  # Foot (FT)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:foot)
    AS ?geofFoot
  )

  BIND(
    spatialF:buffer(?point, 1, uom:foot)
    AS ?spatialFoot
  )


  # ---------------------------------------------------------
  # Yard (YD)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:yard)
    AS ?geofYard
  )

  BIND(
    spatialF:buffer(?point, 1, uom:yard)
    AS ?spatialYard
  )


  # ---------------------------------------------------------
  # Radian (R)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:radian)
    AS ?geofRadian
  )

  BIND(
    spatialF:buffer(?point, 1, uom:radian)
    AS ?spatialRadian
  )


  # ---------------------------------------------------------
  # Degree (D)
  # ---------------------------------------------------------

  BIND(
    geof:buffer(?point, 1, uom:degree)
    AS ?geofDegree
  )

  BIND(
    spatialF:buffer(?point, 1, uom:degree)
    AS ?spatialDegree
  )


}