[PrefixDeclaration]
:      http://example.org/
ex:    http://example.org/ontology#
geo:   http://www.opengis.net/ont/geosparql#
rdfs:  http://www.w3.org/2000/01/rdf-schema#
xsd:   http://www.w3.org/2001/XMLSchema#
fhir:  http://hl7.org/fhir/
time:  http://www.w3.org/2006/time#

[MappingDeclaration] @collection [[

mappingId traffic_safety_mapping
target :observation/trafficAccident/{vkl_nummer}/{jaar_vkl} a ex:transportAccident, ex:observation ; ex:ID "{vkl_nummer}"^^xsd:string ; time:inXSDgYear "{jaar_vkl}"^^xsd:gYear ; ex:neighbourhood :location/trafficAccidentLocation/{fk_veld5} . :location/trafficAccidentLocation/{fk_veld5} a ex:physicalLocation, geo:Feature . :location/trafficAccidentLocation/{fk_veld5}/{jaar_vkl} a ex:physicalLocationVersion, geo:Feature ; ex:versionOf :location/trafficAccidentLocation/{fk_veld5} ; geo:hasGeometry :location/trafficAccidentLocation/{fk_veld5}/geometry/{jaar_vkl} ; time:inXSDgYear "{jaar_vkl}"^^xsd:gYear . :location/trafficAccidentLocation/{fk_veld5}/geometry/{jaar_vkl} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/28992> {coordinates_wkt}"^^geo:wktLiteral ; time:inXSDgYear "{jaar_vkl}"^^xsd:gYear .
source SELECT t.vkl_nummer, t.jaar_vkl, t.fk_veld5, l.coordinates_wkt FROM traffic_safety t JOIN traffic_safety_location_filter l ON t.fk_veld5 = l."FK_VELD5" WHERE t.vkl_nummer IS NOT NULL AND t.fk_veld5 IS NOT NULL AND l.coordinates_wkt IS NOT NULL AND t.jaar_vkl = '2025'

mappingId weather_station_mapping_2026_03
target :weatherStation/{wmoId} a ex:weatherStation, geo:Feature ; ex:ID "{wmoId}"^^xsd:string ; ex:name "{name}"^^xsd:string ; ex:neighbourhood :location/weatherStation/{wmoId} . :location/weatherStation/{wmoId} a ex:physicalLocation, geo:Feature . :location/weatherStation/{wmoId}/{location_time} a ex:physicalLocationVersion, geo:Feature ; ex:versionOf :location/weatherStation/{wmoId} ; geo:hasGeometry :location/weatherStation/{wmoId}/geometry/{location_time} ; time:inXSDDateTimeStamp "{location_time}"^^xsd:dateTimeStamp . :location/weatherStation/{wmoId}/geometry/{location_time} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> {geometry}"^^geo:wktLiteral ; time:inXSDDateTimeStamp "{location_time}"^^xsd:dateTimeStamp .
source SELECT wmo_id AS "wmoId", name, coordinates_wkt AS geometry, CAST('2026-03-09T08:26:38Z' AS TIMESTAMP WITH TIME ZONE) AS location_time FROM weather_station

mappingId weather_data_mapping_2026_03
target :observation/weather/{wmoId}/{time} a ex:observation ; ex:code "weather" ; rdfs:label "weather"^^xsd:string ; ex:neighbourhood :weatherStation/{wmoId} ; ex:component :temperature/{wmoId}/{time} ; ex:component :precipitation/{wmoId}/{time}; ex:component :windSpeed/{wmoId}/{time} ; ex:component :humidity/{wmoId}/{time} ; time:inXSDDateTimeStamp "{time}"^^xsd:dateTimeStamp . :temperature/{wmoId}/{time} a ex:observationComponent ; ex:value "{air_temperature_1_5m}"^^xsd:float ; time:inXSDDateTimeStamp "{time}"^^xsd:dateTimeStamp . :precipitation/{wmoId}/{time} a ex:observationComponent ; ex:value "{precipitation_intensity_past_10min}"^^xsd:float ; time:inXSDDateTimeStamp "{time}"^^xsd:dateTimeStamp . :windSpeed/{wmoId}/{time} a ex:observationComponent ; ex:value "{wind_speed_past_hour}"^^xsd:float ; time:inXSDDateTimeStamp "{time}"^^xsd:dateTimeStamp . :humidity/{wmoId}/{time} a ex:observationComponent ; ex:value "{relative_humidity_1_5m}"^^xsd:float ; time:inXSDDateTimeStamp "{time}"^^xsd:dateTimeStamp .
source SELECT ws.wmo_id AS "wmoId", w.observation_time AS time, w.air_temperature_1_5m, w.wind_speed_past_hour, w.precipitation_intensity_past_10min, w.relative_humidity_1_5m FROM weather w JOIN weather_station ws ON w.coordinates_wkt = ws.coordinates_wkt

mappingId public_transportation_mapping
target :public_transport_stop/{id} a ex:publicTransportStop ; ex:ID "{id}"^^xsd:string ; ex:name "{stopplace_publicname}"^^xsd:string ; ex:typeOfStation "{stopplace_type}"^^xsd:string ; ex:neighbourhood :location/publicTransport/{id} . :location/publicTransport/{id} a ex:physicalLocation, geo:Feature. :location/publicTransport/{id}/{time} a ex:physicalLocationVersion, geo:Feature ; ex:versionOf :location/publicTransport/{id} ; ex:isLocatedInStreet "{stopplace_street}"^^xsd:string ; ex:isLocatedInTown "{stopplace_town}"^^xsd:string ; geo:hasGeometry :location/publicTransport/{id}/geometry/{time} ; time:inXSDDate "{time}"^^xsd:date . :location/publicTransport/{id}/geometry/{time} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/28992> {geometry}"^^geo:wktLiteral ; time:inXSDDate "{time}"^^xsd:date .
source SELECT stopplace_type, id, stopplace_publicname, stopplace_street, stopplace_town, geometry, '2026-06-09' AS time FROM public_transport WHERE stopplace_publicname IS NOT NULL

mappingId taxi_mapping
target :public_transport_stop/taxi/{haltenr} a ex:publicTransportStop ; ex:typeOfStation "taxi"^^xsd:string ; ex:ID "{haltenr}"^^xsd:string ; ex:neighbourhood :location/taxi/{haltenr} . :location/taxi/{haltenr} a ex:physicalLocation, geo:Feature. :location/taxi/{haltenr}/{time} a ex:physicalLocationVersion, geo:Feature ; ex:versionOf :location/taxi/{haltenr} ; geo:hasGeometry :location/taxi/{haltenr}/geometry/{time} ; time:inXSDDate "{time}"^^xsd:date . :location/taxi/{haltenr}/geometry/{time} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/28992> {geometry}"^^geo:wktLiteral ; time:inXSDDate "{time}"^^xsd:date .
source SELECT haltenr, plaats_halte, geometry, '2018-12-25' AS time FROM taxi_stops WHERE haltenr IS NOT NULL

mappingId area_proportion_of_green_space_buurt
target :observation/areaProportionBuurt/{bu_code}/{time} a ex:observation ; ex:code "ratio of areas" ; rdfs:label "Area proportion of green space (vegetation)"^^xsd:string ; ex:facilityType "vegetation"^^xsd:string ; ex:neighbourhood :neighbourhoodUnit/{bu_code}/{time} ; ex:component :Component_mean/areaProportionBuurt/{bu_code}/{time} ; ex:component :Component_standard_deviation/areaProportionBuurt/{bu_code}/{time} ; ex:component :Component_min/areaProportionBuurt/{bu_code}/{time} ; ex:component :Component_max/areaProportionBuurt/{bu_code}/{time} ; time:inXSDgYear "{time}"^^xsd:gYear . :Component_mean/areaProportionBuurt/{bu_code}/{time} a ex:observationComponent ; ex:code "mean" ; ex:value "{mean}"^^xsd:float . :Component_standard_deviation/areaProportionBuurt/{bu_code}/{time} a ex:observationComponent ; ex:code "standard deviation" ; ex:value "{stdev}"^^xsd:float . :Component_min/areaProportionBuurt/{bu_code}/{time} a ex:observationComponent ; ex:code "minimum" ; ex:value "{min}"^^xsd:float . :Component_max/areaProportionBuurt/{bu_code}/{time} a ex:observationComponent; ex:code "maximum" ; ex:value "{max}"^^xsd:float . :neighbourhoodUnit/{bu_code} a ex:neighbourhoodUnit, geo:Feature ; ex:ID "{bu_code}"^^xsd:string ; ex:name "{bu_naam}"^^xsd:string . :neighbourhoodUnit/{bu_code}/{time} a ex:neighbourhoodUnitVersion, geo:Feature ; ex:versionOf :neighbourhoodUnit/{bu_code} ; geo:hasGeometry :neighbourhoodUnit/{bu_code}/geometry/{time} ; geo:sfWithin :district/{wk_code}/{time} ; time:inXSDgYear "{time}"^^xsd:gYear . :neighbourhoodUnit/{bu_code}/geometry/{time} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/28992> {geometry}"^^geo:wktLiteral ; time:inXSDgYear "{time}"^^xsd:gYear . :district/{wk_code} a ex:district, geo:Feature ; ex:ID "{wk_code}"^^xsd:string . :district/{wk_code}/{time} a ex:districtVersion, geo:Feature ; ex:versionOf :district/{wk_code} ; geo:sfWithin :municipality/{gm_code}/{time} ; time:inXSDgYear "{time}"^^xsd:gYear . :municipality/{gm_code} a ex:municipality, geo:Feature ; ex:ID "{gm_code}"^^xsd:string . :municipality/{gm_code}/{time} a ex:municipalityVersion, geo:Feature ; ex:versionOf :municipality/{gm_code} ; time:inXSDgYear "{time}"^^xsd:gYear .
source SELECT bu_code, bu_naam, wk_code, gm_code, mean / 100.0 AS mean, stdev / 100.0 AS stdev, min / 100.0 AS min, max / 100.0 AS max, geometry, '2022' AS time FROM green_space_buurt

mappingId area_proportion_of_green_space_wijk
target :observation/areaProportionWijk/{wk_code}/{time} a ex:observation ; ex:code "ratio of areas" ; ex:facilityType "vegetation"^^xsd:string ; rdfs:label "Area proportion of green space (vegetation)"^^xsd:string ; ex:neighbourhood :district/{wk_code}/{time} ; ex:component :Component_mean/areaProportionWijk/{wk_code}/{time} ; ex:component :Component_standard_deviation/areaProportionWijk/{wk_code}/{time} ; ex:component :Component_min/areaProportionWijk/{wk_code}/{time} ; ex:component :Component_max/areaProportionWijk/{wk_code}/{time} ; time:inXSDgYear "{time}"^^xsd:gYear . :Component_mean/areaProportionWijk/{wk_code}/{time} a ex:observationComponent ; ex:code "mean" ; ex:value "{mean}"^^xsd:float . :Component_standard_deviation/areaProportionWijk/{wk_code}/{time} a ex:observationComponent ; ex:code "standard deviation" ; ex:value "{stdev}"^^xsd:float . :Component_min/areaProportionWijk/{wk_code}/{time} a ex:observationComponent ; ex:code "minimum" ; ex:value "{min}"^^xsd:float . :Component_max/areaProportionWijk/{wk_code}/{time} a ex:observationComponent ; ex:code "maximum" ; ex:value "{max}"^^xsd:float . :district/{wk_code} a ex:district, geo:Feature ; ex:ID "{wk_code}"^^xsd:string ; ex:name "{wk_naam}"^^xsd:string . :district/{wk_code}/{time} a ex:districtVersion, geo:Feature ; ex:versionOf :district/{wk_code} ; geo:hasGeometry :district/{wk_code}/geometry/{time} ; geo:sfWithin :municipality/{gm_code}/{time} ; time:inXSDgYear "{time}"^^xsd:gYear . :district/{wk_code}/geometry/{time} a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/28992> {geometry}"^^geo:wktLiteral ; time:inXSDgYear "{time}"^^xsd:gYear . :municipality/{gm_code} a ex:municipality, geo:Feature ; ex:ID "{gm_code}"^^xsd:string . :municipality/{gm_code}/{time} a ex:municipalityVersion, geo:Feature ; ex:versionOf :municipality/{gm_code} ; time:inXSDgYear "{time}"^^xsd:gYear .
source SELECT wk_code, wk_naam, gm_code, mean / 100.0 AS mean, stdev / 100.0 AS stdev, min / 100.0 AS min, max / 100.0 AS max, geometry, '2022' AS time FROM green_space_wijk

mappingId crime_safety_mapping_2026_07_district
target :observation/crimeSafetyDistrict/{Administrative_territorial_entity_ID}/{observationTime} a ex:observation ; ex:code "safety crime" ; ex:eventType "crime"^^xsd:string ; ex:neighbourhood :district/{Administrative_territorial_entity_ID}/{areaTime} ; ex:value "{NumberOfRegisteredCrimes}"^^xsd:integer ; time:inXSDgYearMonth "{observationTime}"^^xsd:gYearMonth . :district/{Administrative_territorial_entity_ID} a ex:district, geo:Feature ; ex:ID "{Administrative_territorial_entity_ID}"^^xsd:string . :district/{Administrative_territorial_entity_ID}/{areaTime} a ex:districtVersion, geo:Feature ; ex:versionOf :district/{Administrative_territorial_entity_ID} ; time:inXSDgYear "{areaTime}"^^xsd:gYear .
source SELECT wijken_en_buurten AS "Administrative_territorial_entity_ID", CAST( NULLIF(geregistreerde_misdrijven, '') AS INTEGER ) AS "NumberOfRegisteredCrimes", '2026-07' AS "observationTime", '2026' AS "areaTime" FROM crime_safety WHERE wijken_en_buurten LIKE 'WK%'

mappingId crime_safety_mapping_2026_07_neighbourhoodUnit
target :observation/crimeSafetyNeighbourhood/{Administrative_territorial_entity_ID}/{observationTime} a ex:observation ; ex:code "safety crime" ; ex:eventType "crime"^^xsd:string ; ex:neighbourhood :neighbourhoodUnit/{Administrative_territorial_entity_ID}/{areaTime} ; ex:value "{NumberOfRegisteredCrimes}"^^xsd:integer ; time:inXSDgYearMonth "{observationTime}"^^xsd:gYearMonth . :neighbourhoodUnit/{Administrative_territorial_entity_ID} a ex:neighbourhoodUnit, geo:Feature ; ex:ID "{Administrative_territorial_entity_ID}"^^xsd:string . :neighbourhoodUnit/{Administrative_territorial_entity_ID}/{areaTime} a ex:neighbourhoodUnitVersion, geo:Feature ; ex:versionOf :neighbourhoodUnit/{Administrative_territorial_entity_ID} ; time:inXSDgYear "{areaTime}"^^xsd:gYear .
source SELECT wijken_en_buurten AS "Administrative_territorial_entity_ID", CAST( NULLIF(geregistreerde_misdrijven, '') AS INTEGER ) AS "NumberOfRegisteredCrimes", '2026-07' AS "observationTime", '2026' AS "areaTime" FROM crime_safety WHERE wijken_en_buurten LIKE 'BU%'


mappingId cbs_mapping_district
target :observation/inlandWaterDistrict/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "ratio of areas" ; ex:facilityType "landWater"^^xsd:string ; rdfs:label "Area proportion of inland water"^^xsd:string ; ex:neighbourhood :district/{alle_regio_indelingen}/{time} ; ex:value "{area_proportion_of_inland_water}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :observation/residentialAreaDistrict/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "ratio of areas" ; ex:facilityType "dwelling"^^xsd:string ; rdfs:label "Area proportion of residential area"^^xsd:string ; ex:neighbourhood :district/{alle_regio_indelingen}/{time} ; ex:value "{area_proportion_of_residential_area}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :observation/landUseDiversityDistrict/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "diversity" ; ex:facilityType "dwelling"^^xsd:string ; ex:facilityType "commercialArea"^^xsd:string ; ex:facilityType "culturalArea"^^xsd:string ; ex:facilityType "publicService"^^xsd:string ; ex:facilityType "recreationArea"^^xsd:string ; rdfs:label "land use entropy index"^^xsd:string ; ex:neighbourhood :district/{alle_regio_indelingen}/{time} ; ex:value "{land_use_entropy}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :district/{alle_regio_indelingen} a ex:district, geo:Feature ; ex:ID "{alle_regio_indelingen}"^^xsd:string . :district/{alle_regio_indelingen}/{time} a ex:districtVersion, geo:Feature ; ex:versionOf :district/{alle_regio_indelingen} ; time:inXSDgYear "{time}"^^xsd:gYear .
source SELECT alle_regio_indelingen, soort_regio, CAST( NULLIF(totaal_binnenwater, '') AS DOUBLE PRECISION ) / NULLIF( CAST( NULLIF(totaal_land_en_water, '') AS DOUBLE PRECISION ), 0 ) AS area_proportion_of_inland_water, CAST( NULLIF(woonterrein, '') AS DOUBLE PRECISION ) / NULLIF( CAST( NULLIF(totaal_land_en_water, '') AS DOUBLE PRECISION ), 0 ) AS area_proportion_of_residential_area, CAST( NULLIF(land_use_diversity, '') AS DOUBLE PRECISION ) AS land_use_entropy, '2022' AS time FROM land_use WHERE soort_regio = 'Wijk'

mappingId cbs_mapping_neighbourhood
target :observation/inlandWaterNeighbourhoodUnit/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "ratio of areas" ; ex:facilityType "landWater"^^xsd:string ; rdfs:label "Area proportion of inland water"^^xsd:string ; ex:neighbourhood :neighbourhoodUnit/{alle_regio_indelingen}/{time} ; ex:value "{area_proportion_of_inland_water}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :observation/residentialAreaNeighbourhoodUnit/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "ratio of areas" ; ex:facilityType "dwelling"^^xsd:string ; rdfs:label "Area proportion of residential area"^^xsd:string ; ex:neighbourhood :neighbourhoodUnit/{alle_regio_indelingen}/{time} ; ex:value "{area_proportion_of_residential_area}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :observation/landUseDiversityNeighbourhoodUnit/{alle_regio_indelingen}/{time} a ex:observation ; ex:code "diversity" ; ex:facilityType "dwelling"^^xsd:string ; ex:facilityType "commercialArea"^^xsd:string ; ex:facilityType "culturalArea"^^xsd:string ; ex:facilityType "publicService"^^xsd:string ; ex:facilityType "recreationArea"^^xsd:string ; rdfs:label "land use entropy index"^^xsd:string ; ex:neighbourhood :neighbourhoodUnit/{alle_regio_indelingen}/{time} ; ex:value "{land_use_entropy}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear . :neighbourhoodUnit/{alle_regio_indelingen} a ex:neighbourhoodUnit, geo:Feature ; ex:ID "{alle_regio_indelingen}"^^xsd:string . :neighbourhoodUnit/{alle_regio_indelingen}/{time} a ex:neighbourhoodUnitVersion, geo:Feature ; ex:versionOf :neighbourhoodUnit/{alle_regio_indelingen} ; time:inXSDgYear "{time}"^^xsd:gYear .
source SELECT alle_regio_indelingen, soort_regio, CAST( NULLIF(totaal_binnenwater, '') AS DOUBLE PRECISION ) / NULLIF( CAST( NULLIF(totaal_land_en_water, '') AS DOUBLE PRECISION ), 0 ) AS area_proportion_of_inland_water, CAST( NULLIF(woonterrein, '') AS DOUBLE PRECISION ) / NULLIF( CAST( NULLIF(totaal_land_en_water, '') AS DOUBLE PRECISION ), 0 ) AS area_proportion_of_residential_area, CAST( NULLIF(land_use_diversity, '') AS DOUBLE PRECISION ) AS land_use_entropy, '2022' AS time FROM land_use WHERE soort_regio = 'Buurt'

mappingId vegetation_raster_mapping
target :observation/{indicator}/{grid_id}/{time} a ex:observation ; ex:code "{code}"^^xsd:string ; rdfs:label "{label}"^^xsd:string ; ex:facilityType "vegetation"^^xsd:string ; ex:neighbourhood :grid/{grid_id}/{time} ; ex:value "{value}"^^xsd:float ; time:inXSDgYear "{time}"^^xsd:gYear .:grid/{grid_id}/{time} a ex:grid, geo:Feature ; ex:ID "{grid_id}"^^xsd:string ; geo:hasGeometry :grid/{grid_id}/geometry/{time} ; time:inXSDgYear "{time}"^^xsd:gYear .:grid/{grid_id}/geometry/{time} a geo:Geometry ; geo:asWKT "{geometry}"^^geo:wktLiteral ; time:inXSDgYear "{time}"^^xsd:gYear .
source SELECT 'areaProportionGreenSpaceRaster' AS indicator, 'ratio of areas' AS code, 'Area proportion of green space (vegetation)' AS label, md5(geometry) AS grid_id, geometry, value / 100.0 AS value, '2022' AS time FROM raster_green_space WHERE geometry IS NOT NULL AND value IS NOT NULL UNION ALL SELECT 'NDVI' AS indicator, 'Normalized Difference Vegetation Index (NDVI)' AS code, 'Normalized Difference Vegetation Index (NDVI)' AS label, md5(geometry) AS grid_id, geometry, value AS value, '2022' AS time FROM raster_ndvi WHERE geometry IS NOT NULL AND value IS NOT NULL
]]
