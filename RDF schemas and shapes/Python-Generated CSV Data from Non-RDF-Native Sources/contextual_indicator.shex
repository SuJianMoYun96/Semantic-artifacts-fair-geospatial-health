   geosparql:hasGeometry  @:Geometry                         # 100.0 %
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT06004024210328/geometry/2025> ;
   ex-onto:versionOf  @:Feature  OR  @:physicalLocation
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT06004024210328> ;
            # 100.0 % obj: @:Feature. Cardinality: {1}
            # 100.0 % obj: @:physicalLocation. Cardinality: {1}
   time:inXSDgYear  xsd:gYear  ?
            // rdfs:comment "2025" ;
            # 76.61386023584475 % obj: xsd:gYear. Cardinality: {1}
