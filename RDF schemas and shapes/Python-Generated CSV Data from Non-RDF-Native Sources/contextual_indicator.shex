            # 0.2288626391721027 % obj: ex-onto:municipalityVersion. Cardinality: {1}
   rdf:type  [ex-onto:weatherStation]  ?;
            # 0.025613987232924285 % obj: ex-onto:weatherStation. Cardinality: {1}
   ex-onto:neighbourhood  @:Feature  OR  @:physicalLocation  ?
            // rdfs:comment <http://example.org/location/weatherStation/06238> ;
            # 0.025613987232924285 % with cardinality {1}
            # 0.025613987232924285 % obj: @:Feature. Cardinality: {1}
            # 0.025613987232924285 % obj: @:physicalLocation. Cardinality: {1}
   time:inXSDDateTimeStamp  xsd:dateTimeStamp  ?
            // rdfs:comment "2026-03-09T08:26:38Z" ;
            # 0.025613987232924285 % obj: xsd:dateTimeStamp. Cardinality: {1}
} // shexer:conformant_example <http://example.org/location/trafficAccidentLocation/HTT06004024210328>


:physicalLocation
