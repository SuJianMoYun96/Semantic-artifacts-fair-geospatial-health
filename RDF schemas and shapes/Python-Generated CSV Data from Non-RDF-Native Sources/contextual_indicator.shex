            # 0.4243743870319083 % obj: @:municipalityVersion. Cardinality: {1}
            # 0.000616823236964983 % obj: @:weatherStation. Cardinality: {1}
   rdf:type  [ex-onto:observation]  ;                          # 100.0 %
   time:inXSDgYear  xsd:gYear  ?
