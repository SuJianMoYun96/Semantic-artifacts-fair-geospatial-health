} // shexer:conformant_example <http://example.org/Component_mean/areaProportionBuurt/BU17081801/2022>


:Geometry
{
   rdf:type  [geosparql:Geometry]  ;                           # 100.0 %
   geosparql:asWKT  geosparql:wktLiteral  +                   # 100.0 %
            // rdfs:comment "<http://www.opengis.net/def/crs/EPSG/0/28992> POLYGON ((119107.471 427488.697, ..., 119107.471 427488.697))" ;
