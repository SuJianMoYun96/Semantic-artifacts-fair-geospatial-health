:Feature
{
   rdf:type  [geosparql:Feature]  ;                            # 100.0 %
   ex-onto:versionOf  @:Feature  OR  @:physicalLocation  OR  @:neighbourhoodUnit  OR  @:district  OR  @:municipality  ?
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT06004024210328> ;
            # 52.226587318747775 % with cardinality {1}
