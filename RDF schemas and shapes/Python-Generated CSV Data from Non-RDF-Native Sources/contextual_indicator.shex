   time:inXSDgYear  xsd:gYear  ?
            // rdfs:comment "2025" ;
            # 79.6534421140031 % obj: xsd:gYear. Cardinality: {1}
   time:inXSDDate  xsd:date  ?
            // rdfs:comment "2026-06-09" ;
            # 20.290964225118227 % obj: xsd:date. Cardinality: {1}
   time:inXSDDateTimeStamp  xsd:dateTimeStamp  ?
            // rdfs:comment "2026-03-09T08:26:38Z" ;
            # 0.055593660878668634 % obj: xsd:dateTimeStamp. Cardinality: {1}
} // shexer:conformant_example <http://example.org/location/trafficAccidentLocation/HTT06004024210328/geometry/2025>


:publicTransportStop
{
   ex-onto:neighbourhood  @:Feature  OR  @:physicalLocation
            // rdfs:comment <http://example.org/location/publicTransport/NL%3ACHB%3AStopPlace%3A58460070> ;
            # 100.0 % obj: @:Feature. Cardinality: {1}
            # 100.0 % obj: @:physicalLocation. Cardinality: {1}
   ex-onto:typeOfStation  xsd:string                          # 100.0 %
            // rdfs:comment "onstreetBus" ;
   rdf:type  [ex-onto:publicTransportStop]  ;                  # 100.0 %
   ex-onto:ID  xsd:string                                     # 100.0 %
            // rdfs:comment "NL:CHB:StopPlace:58460070" ;
   ex-onto:name  xsd:string  ?
            // rdfs:comment "Dragoonsplein" ;
            # 98.91830344434955 % obj: xsd:string. Cardinality: {1}
} // shexer:conformant_example <http://example.org/public_transport_stop/NL%3ACHB%3AStopPlace%3A58460070>


:observation
{
   ex-onto:neighbourhood  @:Feature  OR  @:physicalLocation  OR  @:neighbourhoodUnitVersion  OR  @:districtVersion  OR  @:municipalityVersion  OR  @:weatherStation
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT00331390040042> ;
            # 100.0 % obj: @:Feature. Cardinality: {1}
