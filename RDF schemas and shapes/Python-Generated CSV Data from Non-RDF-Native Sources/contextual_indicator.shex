            # 40.08522472115682 % obj: @:physicalLocation. Cardinality: {1}
            # 9.662460872139633 % obj: @:neighbourhoodUnit. Cardinality: {1}
            # 2.250039086279219 % obj: @:district. Cardinality: {1}
            # 0.2288626391721027 % obj: @:municipality. Cardinality: {1}
   geosparql:hasGeometry  @:Geometry  ?
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT06004024210328/geometry/2025> ;
            # 46.07357534670361 % obj: @:Geometry. Cardinality: {1}
   time:inXSDgYear  xsd:gYear  ?
            // rdfs:comment "2025" ;
            # 42.852200640682334 % obj: xsd:gYear. Cardinality: {1}
   rdf:type  [ex-onto:physicalLocation]  ?;
            # 40.08522472115682 % obj: ex-onto:physicalLocation. Cardinality: {1}
   rdf:type  [ex-onto:physicalLocationVersion]  ?;
            # 40.08522472115682 % obj: ex-onto:physicalLocationVersion. Cardinality: {1}
   rdf:type  [ex-onto:neighbourhoodUnitVersion]  ?;
            # 9.662460872139633 % obj: ex-onto:neighbourhoodUnitVersion. Cardinality: {1}
   time:inXSDDate  xsd:date  ?
            // rdfs:comment "2026-06-09" ;
            # 9.348772690832522 % obj: xsd:date. Cardinality: {1}
   ex-onto:isLocatedInTown  xsd:string  ?
            // rdfs:comment "Tilburg" ;
            # 9.247647338640197 % obj: xsd:string. Cardinality: {1}
   ex-onto:isLocatedInStreet  xsd:string  ?
            // rdfs:comment "Lekdijk" ;
            # 9.05936790001896 % obj: xsd:string. Cardinality: {1}
   ex-onto:ID  xsd:string  ?
            // rdfs:comment "06238" ;
            # 7.688187960095403 % obj: xsd:string. Cardinality: {1}
   ex-onto:name  xsd:string  ?
            // rdfs:comment "Medemblik Parkwijk" ;
            # 6.013964612779716 % obj: xsd:string. Cardinality: {1}
   geosparql:sfWithin  @:Feature  OR  @:districtVersion  OR  @:municipalityVersion  ?
            // rdfs:comment <http://example.org/municipality/GM0758/2022> ;
            # 5.873586656775897 % with cardinality {1}
            # 5.873586656775897 % obj: @:Feature. Cardinality: {1}
            # 4.762538379399701 % obj: @:districtVersion. Cardinality: {1}
            # 1.1110482773761963 % obj: @:municipalityVersion. Cardinality: {1}
   rdf:type  [ex-onto:neighbourhoodUnit]  ?;
            # 5.183672247411158 % obj: ex-onto:neighbourhoodUnit. Cardinality: {1}
   rdf:type  [ex-onto:district]  ?;
            # 2.250039086279219 % obj: ex-onto:district. Cardinality: {1}
   rdf:type  [ex-onto:districtVersion]  ?;
            # 2.250039086279219 % obj: ex-onto:districtVersion. Cardinality: {1}
   rdf:type  [ex-onto:municipality]  ?;
            # 0.2288626391721027 % obj: ex-onto:municipality. Cardinality: {1}
