            // rdfs:comment "crime" ;
            # 11.40937941414129 % obj: xsd:string. Cardinality: {1}
   ex-onto:value  xsd:integer  ?
            // rdfs:comment "       0" ;
            # 11.40937941414129 % obj: xsd:integer. Cardinality: {1}
   time:inXSDgYearMonth  xsd:gYearMonth  ?
            // rdfs:comment "2026-07" ;
            # 11.40937941414129 % obj: xsd:gYearMonth. Cardinality: {1}
   ex-onto:component  @:observationComponent  *
            // rdfs:comment <http://example.org/Component_mean/areaProportionBuurt/BU17081801/2022> ;
            # 11.104668735080587 % obj: @:observationComponent. Cardinality: {4}
   rdfs:label  xsd:string  ?
            // rdfs:comment "Area proportion of green space (vegetation)" ;
