} // shexer:conformant_example <http://example.org/neighbourhoodUnit/BU17081801/2022>


:district
{
   rdf:type  [geosparql:Feature]  ;                            # 100.0 %
   rdf:type  [ex-onto:district]  ;                             # 100.0 %
   ex-onto:ID  xsd:string                                     # 100.0 %
            // rdfs:comment "WK039211  " ;
   ex-onto:name  xsd:string  ?
            // rdfs:comment "Meeden" ;
            # 49.37906564163217 % obj: xsd:string. Cardinality: {1}
} // shexer:conformant_example <http://example.org/district/WK039211%20%20>


:districtVersion
