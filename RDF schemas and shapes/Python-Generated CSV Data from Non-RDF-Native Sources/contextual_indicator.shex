:transportAccident
{
   time:inXSDgYear  xsd:gYear                                 # 100.0 %
            // rdfs:comment "2025" ;
   ex-onto:neighbourhood  @:Feature  OR  @:physicalLocation
            // rdfs:comment <http://example.org/location/trafficAccidentLocation/HTT00331390040042> ;
            # 100.0 % obj: @:Feature. Cardinality: {1}
            # 100.0 % obj: @:physicalLocation. Cardinality: {1}
   rdf:type  [ex-onto:observation]  ;                          # 100.0 %
   rdf:type  [ex-onto:transportAccident]  ;                    # 100.0 %
   ex-onto:ID  xsd:string                                      # 100.0 %
            // rdfs:comment "20250000001" ;
} // shexer:conformant_example <http://example.org/observation/trafficAccident/20250000001/2025>


