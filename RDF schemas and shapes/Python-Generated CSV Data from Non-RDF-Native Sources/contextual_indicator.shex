:observationComponent
{
   rdf:type  [ex-onto:observationComponent]  ;                 # 100.0 %
   ex-onto:value  xsd:float                                   # 100.0 %
            // rdfs:comment "0.005911875" ;
   ex-onto:code  xsd:string  ?
            // rdfs:comment "mean" ;
            # 99.99444537021608 % obj: xsd:string. Cardinality: {1}
   time:inXSDDateTimeStamp  xsd:dateTimeStamp  ?
            // rdfs:comment "2026-07-26T10:30:00Z" ;
