:weatherStation
{
   rdf:type  [geosparql:Feature]  ;                            # 100.0 %
   rdf:type  [ex-onto:weatherStation]  ;                       # 100.0 %
   ex-onto:neighbourhood  @:Feature  OR  @:physicalLocation
            // rdfs:comment <http://example.org/location/weatherStation/06238> ;
            # 100.0 % obj: @:Feature. Cardinality: {1}
            # 100.0 % obj: @:physicalLocation. Cardinality: {1}
   ex-onto:ID  xsd:string                                    # 100.0 %
            // rdfs:comment "06238" ;
   ex-onto:name  xsd:string                                    # 100.0 %
            // rdfs:comment "Europlatform" ;
} // shexer:conformant_example <http://example.org/weatherStation/06238>


:neighbourhoodUnit
