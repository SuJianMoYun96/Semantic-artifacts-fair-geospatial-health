            // rdfs:comment "2026-06-09" ;
            # 23.322240940059583 % obj: xsd:date. Cardinality: {1}
   ex-onto:isLocatedInTown  xsd:string  ?
            // rdfs:comment "Tilburg" ;
            # 23.069965063110462 % obj: xsd:string. Cardinality: {1}
   ex-onto:isLocatedInStreet  xsd:string  ?
            // rdfs:comment "Lekdijk" ;
            # 22.6002672132644 % obj: xsd:string. Cardinality: {1}
   time:inXSDDateTimeStamp  xsd:dateTimeStamp  ?
            // rdfs:comment "2026-03-09T08:26:38Z" ;
