#This query tests whether `geof:relate` can be evaluated directly and return a Boolean result.

PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT ?result
WHERE {
  BIND(
    geof:relate(
      "POINT(1 1)"^^geo:wktLiteral,
      "POINT(1 1)"^^geo:wktLiteral,
      "T********"
    )
    AS ?result
  )
}