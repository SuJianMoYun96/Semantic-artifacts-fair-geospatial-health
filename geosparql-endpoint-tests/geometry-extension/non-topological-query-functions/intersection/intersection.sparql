# run at 2026-07-24 21:07

PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

PREFIX geo: <http://www.opengis.net/ont/geosparql#>
SELECT
  ?geometryA
  ?geometryB
  ?intersection
  (BOUND(?intersection) AS ?functionReturnedValue)
WHERE {
  VALUES (?geometryA ?geometryB) {
    (
      "POLYGON((0 0, 0 2, 2 2, 2 0, 0 0))"^^geo:wktLiteral
      "POLYGON((1 1, 1 3, 3 3, 3 1, 1 1))"^^geo:wktLiteral
    )
  }

  BIND(
    geof:intersection(?geometryA, ?geometryB)
    AS ?intersection
  )
}