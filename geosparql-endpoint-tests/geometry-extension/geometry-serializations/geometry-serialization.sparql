PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT
  ?wktLiteral
  ?asWKTPredicate
  ?asWKTFunctionResult
WHERE {

  # Test geo:wktLiteral
  BIND(
    "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(4.895168 52.370216)"^^geo:wktLiteral
    AS ?wktLiteral
  )

  # geo:asWKT is an RDF property, not a function
  BIND(
    geo:asWKT
    AS ?asWKTPredicate
  )

  # Test GeoSPARQL 1.1 geof:asWKT function
  BIND(
    geof:asWKT(?wktLiteral)
    AS ?asWKTFunctionResult
  )
}